# ==============================================================================
# JANSETU: AI Civic Infrastructure Intelligence Grid
# Phase 1: Foundation Environment Configuration
# ==============================================================================

# APPLICATION
APP_NAME=JANSETU
APP_SERVICE="AI Civic Infrastructure Intelligence Grid"
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# GOOGLE CLOUD
GCP_PROJECT_ID=jansetu-gov-ai
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# BIGQUERY
BIGQUERY_DATASET=jansetu_intel
BIGQUERY_LOCATION=asia-south1
BIGQUERY_USE_MOCK=true

# GOOGLE CLOUD PUB/SUB
PUBSUB_TOPIC=citizen-requests-raw
PUBSUB_SUBSCRIPTION=citizen-requests-processor-sub
PUBSUB_USE_MOCK=true

# GOOGLE CLOUD STORAGE
GCS_BUCKET=jansetu-citizen-audio
GCS_EXPORTS_BUCKET=jansetu-data-exports
GCS_USE_MOCK=true

# FIREBASE AUTHENTICATION
FIREBASE_PROJECT_ID=jansetu-gov-ai
FIREBASE_CREDENTIALS_PATH=
FIREBASE_MOCK_AUTH=true

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","https://jansetu.web.app"]

# FRONTEND FIREBASE CONFIG (Public Web Config)
VITE_FIREBASE_API_KEY=mock-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=jansetu-gov-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jansetu-gov-ai
VITE_FIREBASE_STORAGE_BUCKET=jansetu-gov-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
